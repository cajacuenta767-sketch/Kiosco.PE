{
  "name": "@sencillo/api",
  "private": true,
  "version": "0.8.0",
  "type": "module",
  "description": "API de Sencillo: cuentas de bodega, sincronización de cambios y respaldo en la nube.",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "test": "node --test --experimental-strip-types src/*.test.ts",
    "compactar": "node --experimental-strip-types src/compactar.cli.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.0.0",
    "@sencillo/shared": "*",
    "dotenv": "^17.0.0",
    "drizzle-orm": "^0.45.0",
    "fastify": "^5.4.0",
    "pg": "^8.16.0",
    "zod": "^4.0.0",
    "@electric-sql/pglite": "^0.5.0",
    "@fastify/static": "^10.0.0",
    "@fastify/rate-limit": "^11.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/pg": "^8.15.0",
    "drizzle-kit": "^0.31.0",
    "tsx": "^4.20.0",
    "typescript": "~5.8.3"
  }
}
