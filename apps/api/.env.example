# Puerto HTTP
PORT=3000
# Postgres externo (Neon, Supabase, Railway). Si no se define, la API usa PGlite (Postgres embebido) en PGLITE_DIR.
# DATABASE_URL=postgres://usuario:clave@localhost:5432/kiosco
PGLITE_DIR=./data/kiosco
# Orígenes permitidos para CORS, separados por coma. Sin definir: todos (útil en desarrollo).
# CORS_ORIGENES=https://app.kiosco.pe
# Servir la PWA compilada (apps/web/dist) desde este mismo servidor
SERVIR_WEB=true
